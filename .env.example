# Copy to .env for local development. NEVER commit .env or real secrets.
# In production every variable marked REQUIRED must be set; known placeholder values are refused at startup.
NODE_ENV=development
# Development binds to the loopback interface only. Set 0.0.0.0 only behind a reverse proxy / in a container.
SKRIFARI_HOST=127.0.0.1
SKRIFARI_PORT=3000
# REQUIRED in production
SKRIFARI_MONGODB_URI=mongodb://127.0.0.1:27017/skrifari
# REQUIRED in production
SKRIFARI_REDIS_URL=redis://127.0.0.1:6379
# REQUIRED in production: at least 32 random characters (openssl rand -base64 48). Development generates a temporary one.
SKRIFARI_SESSION_SECRET=

# Docker Compose only (docker-compose.yml refuses to start without them): choose long random values.
REDIS_PASSWORD=
